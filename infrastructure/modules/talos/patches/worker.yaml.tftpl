# Per-worker-node machine config patch.
# Hostname is intentionally NOT set here — Proxmox cloud-init already sets it to
# the VM name; setting it again fails Talos validation ("static hostname is
# already set in v1alpha1 config").
machine:
  network:
    interfaces:
      - deviceSelector:
          physical: true
        dhcp: false
        addresses:
          - ${address}/${network_cidr}
        routes:
          - network: 0.0.0.0/0
            gateway: ${gateway}
  install:
    disk: ${install_disk}
